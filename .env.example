# Copy to `.env` and fill in values. `.env` is gitignored and loaded by
# `scripts/env.sh` (and so by every sbatch launcher).

# --- Required ---------------------------------------------------------------
# gpt-4o-mini: training judge in most configs and the HealthBench grader.
OPENAI_API_KEY=
# Hugging Face token; needed on compute nodes for gated GPQA Diamond.
HF_TOKEN=
# Weights & Biases (training logs). Or set `report_to: none` in a config.
WANDB_API_KEY=

# --- Judge providers (only those used by the configs you run) ---------------
# Portkey gateway: Gemini-2.5-flash-lite, gpt-oss-120b, Qwen3-235B-Instruct,
# and DeepSeek-V3.1 in the medicine hard-Likert, Gem+DS and pairwise configs.
# Model names in the configs (e.g. @google/..., @togetherai/...) are Portkey
# provider slugs.
PORTKEY_API_KEY=
# DeepSeek-V3.1 via Together (medicine soft-Likert and DS+Mini retro configs).
TOGETHER_API_KEY=
# DeepSeek-V3.1 via DeepInfra (science single-judge and Gem+DS configs).
DEEPINFRA_API_KEY=
# OpenRouter: DeepSeek-V3.1 (pinned to CoreWeave) and gpt-4o-mini (pinned to
# OpenAI) in the science DS+Mini soft-Likert configs and
# run_jvr_4o_mini_reward_dsmini_drop030.
OPENROUTER_API_KEY=
# DeepSeek API (run_jvr_4o_dsmini_softlikert_drop035).
DEEPSEEK_API_KEY=

# --- Storage (optional overrides; defaults are in scripts/env.sh) -----------
# RAR_LOCAL=/tmp/$USER/deep_rl                    # fast node-local scratch
# RAR_STAGE=/workspace/home/$USER/deep_rl_stage   # durable, shared across nodes
# RAR_SHARED_HF_HUB=                              # shared HF cache to mirror models from
